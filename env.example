# ─────────────────────────────────────────────────────────────
#  Virutcham Magalir Munnetra Kalzangiam — Environment Config
#  Copy this file to .env and fill in your real credentials
#  NEVER share this file or upload it to GitHub
# ─────────────────────────────────────────────────────────────

# Flask
FLASK_SECRET_KEY=change-this-to-a-random-strong-secret
FLASK_DEBUG=false
PORT=5000

# ── Admin Panel Login (OFFICE STAFF ONLY) ───────────────────────
# Donors and website visitors can NEVER see or access this.
# Change these to your own secret username/password before going live.
ADMIN_USERNAME=replace-with-office-username
ADMIN_PASSWORD=replace-with-a-strong-office-password

# Password recovery (configure SMTP to send one-time reset links)
OFFICE_RECOVERY_EMAIL=office@example.org
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
PUBLIC_BASE_URL=http://127.0.0.1:5000

# Razorpay (get from https://dashboard.razorpay.com)
# Use rzp_test_* keys for testing, rzp_live_* for production
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Twilio SMS (get from https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1XXXXXXXXXX   # Your Twilio number

# NGO Contact Info (can also be edited live from the admin panel)
NGO_EMAIL=contact@virutcham.org
NGO_PHONE=+91XXXXXXXXXX
